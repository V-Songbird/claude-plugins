{
  "model": "sonnet",
  "reps": 2,
  "concurrency": 3,
  "maxTurns": 60,
  "runTimeoutMs": 900000,
  "segments": {
    "noisy-output": "noisy build and test output",
    "search-heavy": "search-heavy work",
    "long-session": "long sessions that drift"
  },
  "defaultTasks": [
    "log-triage",
    "dep-bump-warnings",
    "failing-suite",
    "release-digest",
    "repo-sweep",
    "rename-scope",
    "feature-drift",
    "incident-forensics"
  ]
}
