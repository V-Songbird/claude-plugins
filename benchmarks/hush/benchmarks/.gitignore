# Your local run output — transcripts, per-run JSON, generated reports.
# Full of your paths and your machine's name, so it stays on your machine.
results/

# records/ is deliberately NOT ignored: those are the sanitized, hashed,
# write-once copies a published number is generated from. Keep them.
# records/*/published/ is committed too — the readiness gate compares each
# batch's committed claim set byte-for-byte against what the records
# regenerate, so a stale publish is caught instead of shipped.
